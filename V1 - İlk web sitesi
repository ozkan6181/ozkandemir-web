  .main-nav.open a{padding:13px 0;border-bottom:1px solid var(--line)}
  .hero-grid{grid-template-columns:1fr 1fr}
  .service-grid{grid-template-columns:repeat(3,1fr)}
  .trust-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:760px){
  .container{width:min(100% - 28px,1180px)}
  .nav-wrap{height:68px}
  .brand-text strong{font-size:16px}
  .brand-text small{font-size:7px}
  .brand-mark{width:40px;height:40px}
  .hero-grid{grid-template-columns:1fr;min-height:auto;padding:70px 0}
  .hero h1{font-size:48px}
  .hero h2{font-size:32px}
  .hero-card{justify-content:stretch}
  .hero-card-inner{min-height:260px}
  .trust-grid{grid-template-columns:1fr}
  .section{padding:62px 0}
  .section-heading{display:block}
  .section-heading h2,.about h2,.contact h2{font-size:33px}
  .section-heading p{margin-top:16px}
  .service-grid,.digital-grid,.article-grid{grid-template-columns:1fr}
  .about-grid,.contact-grid{grid-template-columns:1fr}
  .about-copy{padding:62px 0}
  .experience-panel{margin-left:-14px;margin-right:-14px;padding:50px 28px}
  .experience-points{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr;gap:32px}
  .contact-grid{gap:30px}
  .contact-card a,.contact-card>div{flex-direction:column;gap:3px}
  .contact-card strong{text-align:left}
}

