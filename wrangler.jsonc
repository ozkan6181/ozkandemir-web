{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ozkandemir-web",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* : mevcut canlı veri API'leri (BIST, TCMB, haberler)
    // /panel, /panel/* : V3.6 yönetim paneli (ekranlar + /panel/api/*)
    // /indir/* : müşteri indirme bağlantıları
    "run_worker_first": ["/api/*", "/panel", "/panel/*", "/indir/*"]
  },
  // V3.6 Panel veritabanı — database_id değerini "npx wrangler d1 create ozkandemir-panel" çıktısından yapıştırın
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ozkandemir-panel",
      "database_id": "BURAYA_D1_DATABASE_ID_YAPISTIRIN",
      "migrations_dir": "migrations"
    }
  ],
  // V3.6 Program dosyaları — herkese kapalı R2 deposu
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "ozkandemir-programlar" }
  ],
  // Cloudflare Access (KURULUM-PANEL.md 5. adım). Boş bırakılırsa panel şifre + doğrulama kodu ile korunur.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
